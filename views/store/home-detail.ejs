<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home</title>
    <link rel="stylesheet" href="output.css" />
    <link rel="stylesheet" href="input.css" />
    <link rel="stylesheet" href="style.css" />
  </head>
   <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background-color: #f5f7fa;
    }

    .hero-box {
      background: linear-gradient(135deg, #1abc9c, #16a085);
      color: white;
      text-align: center;
      padding: 60px 20px;
      border-radius: 12px;
      width: 90%;
      max-width: 800px;
      margin: 40px auto;
      box-shadow: 0 6px 20px rgba(0,0,0,0.15);
    }

    .header {
      font-size: 2.5rem;
      margin-bottom: 20px;
    }

    .btn {
      display: inline-block;
      background: white;
      color: #16a085;
      padding: 12px 20px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: bold;
      transition: 0.3s;
    }

    .btn:hover {
      background: #f1f1f1;
    }

    /* Container for all cards */
.homes-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 20px;
  width: 90%;
  margin: 20px auto;
}

/* Individual card */
.card {
  background: white;
  padding: 15px;
  border-radius: 10px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.1);
}

.book {
  background-color:  rgb(131, 243, 131) ;
  margin-top: 20px;
  border: none;
}

.det_btn {
  background-color: rgb(92, 92, 248);
}
  </style>
 <body>
      <%- include('../partials/nav') %>
      <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-6xl">
          <h2 class="text-3xl text-red-500 font-bold text-center mb-6">
              Details of <%= home.houseName %>
          </h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <div class="rounded-lg overflow-hidden">
                  <img src="<%= home.photo %>" alt="<%= home.houseName %>" class="w-full h-96 object-cover">
              </div>
              
              <div class="space-y-6">
                  <div class="border-b pb-4">
                      <h3 class="text-2xl font-semibold mb-2">Description</h3>
                      <p class="text-gray-600"><%= home.description %></p>
                  </div>

                  <div class="border-b pb-4">
                      <h3 class="text-2xl font-semibold mb-2">Location</h3>
                      <p class="text-gray-600"><%= home.location %></p>
                  </div>
                  
                  <div class="border-b pb-4">
                      <h3 class="text-2xl font-semibold mb-2">Price</h3>
                      <p class="text-green-600 text-xl font-bold">$<%= home.price %> / night</p>
                  </div>
                  
                  <div class="border-b pb-4">
                      <h3 class="text-2xl font-semibold mb-2">Rating</h3>
                      <div class="flex items-center">
                          <span class="text-yellow-400 text-xl">★</span>
                          <span class="ml-2 text-lg"><%= home.rating %> / 5</span>
                      </div>
                    </div>
              </div>
              <%- include('../partials/fav', { home: home }) %>
          </div>
      </main>
  
  </body>
</html>